# Database
DATABASE_URL=postgresql://eduflow:eduflow@localhost:5432/eduflow
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_URL=http://localhost:9200

# Auth
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this-in-production
JWT_QR_SECRET=your-jwt-qr-secret-change-this-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Optional — require this code on POST /auth/register
TEACHER_REGISTRATION_CODE=

# Email (optional — without SMTP, emails are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@eduflow.local
APP_NAME=EduFlow
CLEVER_CLIENT_ID=
CLEVER_CLIENT_SECRET=
APP_URL=http://localhost:3001

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# AI / Translation
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# App
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
